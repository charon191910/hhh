08\u200b\u7528\u4e8e\u200b\u6559\u5b66\u200b\u548c\u200b\u5165\u95e8\u200b\u5b66\u4e60\u200b\u3002</p>"},{"location":"CNN_project/#_2","title":"\u9879\u76ee\u200b\u7279\u70b9","text":"<ul> <li>\u200b\u5b8c\u6574\u200b\u6d41\u7a0b\u200b\uff1a\u200b\u4ece\u200b\u6570\u636e\u200b\u52a0\u8f7d\u200b\u5230\u200b\u6a21\u578b\u200b\u8bad\u7ec3\u200b\u3001\u200b\u8bc4\u4f30\u200b\u7684\u200b\u5168\u200b\u6d41\u7a0b\u200b\u5b9e\u73b0\u200b</li> <li>\u200b\u8be6\u7ec6\u200b\u6ce8\u91ca\u200b\uff1a\u200b\u4ee3\u7801\u200b\u4e2d\u200b\u5305\u542b\u200b\u8be6\u7ec6\u200b\u7684\u200b\u4e2d\u6587\u200b\u6ce8\u91ca\u200b\uff0c\u200b\u4fbf\u4e8e\u200b\u7406\u89e3\u200b\u6bcf\u4e2a\u200b\u6a21\u5757\u200b\u7684\u200b\u529f\u80fd\u200b</li> <li>\u200b\u6a21\u5757\u5316\u200b\u8bbe\u8ba1\u200b\uff1a\u200b\u5c06\u200b\u6570\u636e\u200b\u52a0\u8f7d\u200b\u3001\u200b\u6a21\u578b\u200b\u5b9a\u4e49\u200b\u3001\u200b\u8bad\u7ec3\u200b\u3001\u200b\u8bc4\u4f30\u200b\u7b49\u200b\u529f\u80fd\u200b\u5206\u79bb\u200b\uff0c\u200b\u7ed3\u6784\u200b\u6e05\u6670\u200b</li> <li>\u200b\u6559\u5b66\u200b\u53cb\u597d\u200b\uff1a\u200b\u4f7f\u7528\u200b\u6807\u51c6\u200b\u7684\u200bCNN\u200b\u67b6\u6784\u200b\uff0c\u200b\u6613\u4e8e\u200b\u7406\u89e3\u200b\u548c\u200b\u6269\u5c55\u200b</li> </ul>"},{"location":"CNN_project/#_3","title":"\u6280\u672f\u200b\u67b6\u6784","text":""},{"location":"CNN_project/#1","title":"1. \u200b\u7f51\u7edc\u7ed3\u6784","text":"<pre><code>\u200b\u8f93\u5165\u200b\u5c42\u200b (1\u00d728\u00d728) \n    \u2193\n\u200b\u5377\u79ef\u200b\u5c42\u200b1 (32\u200b\u4e2a\u200b3\u00d73\u200b\u5377\u79ef\u200b\u6838\u200b) + BN + ReLU + \u200b\u6700\u5927\u200b\u6c60\u5316\u200b \n    \u2193 (32\u00d714\u00d714)\n\u200b\u5377\u79ef\u200b\u5c42\u200b2 (64\u200b\u4e2a\u200b3\u00d73\u200b\u5377\u79ef\u200b\u6838\u200b\u00d72) + BN + ReLU + \u200b\u6700\u5927\u200b\u6c60\u5316\u200b \n    \u2193 (64\u00d77\u00d77)\n\u200b\u5c55\u5e73\u200b\u5c42\u200b (3136\u200b\u7ef4\u200b)\n    \u2193\n\u200b\u5168\u200b\u8fde\u63a5\u200b\u5c42\u200b1 (1024\u200b\u795e\u7ecf\u5143\u200b) + ReLU + Dropout(0.3)\n    \u2193\n\u200b\u5168\u200b\u8fde\u63a5\u200b\u5c42\u200b2 (10\u200b\u7ef4\u200b\u8f93\u51fa\u200b)\n    \u2193\n\u200b\u5206\u7c7b\u200b\u7ed3\u679c\u200b (0-9\u200b\u6570\u5b57\u200b)\n</code></pre>"},{"location":"CNN_project/#2","title":"2. \u200b\u5173\u952e\u6280\u672f\u200b\u7ec4\u4ef6","text":""},{"location":"CNN_project/#convolutional-layer","title":"\u5377\u79ef\u200b\u5c42\u200b (Convolutional Layer)","text":"<ul> <li>\u200b\u529f\u80fd\u200b\uff1a\u200b\u63d0\u53d6\u200b\u56fe\u50cf\u200b\u7684\u200b\u7a7a\u95f4\u200b\u7279\u5f81\u200b</li> <li>\u200b\u5b9e\u73b0\u200b\uff1a\u200b\u4f7f\u7528\u200b<code>nn.Conv2d</code>\u200b\u6a21\u5757\u200b</li> <li>\u200b\u53c2\u6570\u200b\uff1a\u200b\u8f93\u5165\u200b\u901a\u9053\u200b\u6570\u200b\u3001\u200b\u8f93\u51fa\u200b\u901a\u9053\u200b\u6570\u200b\u3001\u200b\u5377\u79ef\u200b\u6838\u200b\u5927\u5c0f\u200b\u3001\u200b\u6b65\u957f\u200b\u3001\u200b\u586b\u5145\u200b</li> </ul>"},{"location":"CNN_project/#batch-normalization","title":"\u6279\u91cf\u200b\u5f52\u4e00\u5316\u200b (Batch Normalization)","text":"<ul> <li>\u200b\u529f\u80fd\u200b\uff1a\u200b\u52a0\u901f\u200b\u8bad\u7ec3\u200b\u6536\u655b\u200b\uff0c\u200b\u63d0\u9ad8\u200b\u6a21\u578b\u200b\u7a33\u5b9a\u6027\u200b</li> <li>\u200b\u5b9e\u73b0\u200b\uff1a<code>nn.BatchNorm2d</code></li> </ul>"},{"location":"CNN_project/#relu","title":"\u6fc0\u6d3b\u200b\u51fd\u6570\u200b (ReLU)","text":"<ul> <li>\u200b\u529f\u80fd\u200b\uff1a\u200b\u5f15\u5165\u200b\u975e\u7ebf\u6027\u200b\uff0c\u200b\u589e\u5f3a\u200b\u6a21\u578b\u200b\u8868\u8fbe\u80fd\u529b\u200b</li> <li>\u200b\u516c\u5f0f\u200b\uff1af(x) = max(0, x)</li> </ul>"},{"location":"CNN_project/#pooling-layer","title":"\u6c60\u5316\u5c42\u200b (Pooling Layer)","text":"<ul> <li>\u200b\u529f\u80fd\u200b\uff1a\u200b\u964d\u4f4e\u200b\u7279\u5f81\u200b\u56fe\u200b\u7ef4\u5ea6\u200b\uff0c\u200b\u589e\u5f3a\u200b\u5e73\u79fb\u200b\u4e0d\u53d8\u6027\u200b</li> <li>\u200b\u7c7b\u578b\u200b\uff1a\u200b\u6700\u5927\u200b\u6c60\u5316\u200b (Max Pooling)</li> </ul>"},{"location":"CNN_project/#dropout","title":"Dropout\u200b\u6b63\u5219\u200b\u5316","text":"<ul> <li>\u200b\u529f\u80fd\u200b\uff1a\u200b\u9632\u6b62\u200b\u8fc7\u200b\u62df\u5408\u200b\uff0c\u200b\u63d0\u9ad8\u200b\u6cdb\u5316\u200b\u80fd\u529b\u200b</li> <li>\u200b\u673a\u5236\u200b\uff1a\u200b\u8bad\u7ec3\u200b\u65f6\u200b\u968f\u673a\u200b\"\u200b\u5173\u95ed\u200b\"\u200b\u90e8\u5206\u200b\u795e\u7ecf\u5143\u200b</li> </ul>"},{"location":"CNN_project/#_4","title":"\u4ee3\u7801\u200b\u7ed3\u6784\u200b\u89e3\u6790","text":""},{"location":"CNN_project/#1_1","title":"1. \u200b\u8d85\u200b\u53c2\u6570\u8bbe\u7f6e","text":"<pre><code>LEARNING_RATE  = 1e-4   # \u200b\u5b66\u4e60\u200b\u7387\u200b\nKEEP_PROB_RATE = 0.7    # Dropout\u200b\u4fdd\u7559\u200b\u7387\u200b\nMAX_EPOCH      = 3      # \u200b\u8bad\u7ec3\u200b\u8f6e\u6570\u200b\nBATCH_SIZE     = 50     # \u200b\u6279\u200b\u5927\u5c0f\u200b\n</code></pre>"},{"location":"CNN_project/#2_1","title":"2. \u200b\u6570\u636e\u200b\u52a0\u8f7d\u200b\u6a21\u5757","text":"<ul> <li>\u200b\u6570\u636e\u200b\u96c6\u200b\uff1aMNIST\u200b\u624b\u5199\u200b\u6570\u5b57\u200b\uff0860,000\u200b\u8bad\u7ec3\u6837\u672c\u200b\uff0c10,000\u200b\u6d4b\u8bd5\u200b\u6837\u672c\u200b\uff09</li> <li>\u200b\u9884\u5904\u7406\u200b\uff1a\u200b\u8f6c\u4e3a\u200bTensor\u200b\u5e76\u200b\u5f52\u4e00\u5316\u200b\u5230\u200b[0,1]</li> <li>\u200b\u6570\u636e\u200b\u589e\u5f3a\u200b\uff1a\u200b\u968f\u673a\u200b\u6253\u4e71\u200b(Shuffle)</li> </ul>"},{"location":"CNN_project/#3-cnn","title":"3. \u200b\u6a21\u578b\u200b\u5b9a\u4e49\u200b (CNN\u200b\u7c7b\u200b)","text":"<pre><code>class CNN(nn.Module):\n    def __init__(self):\n        # \u200b\u5b9a\u4e49\u200b\u7f51\u7edc\u5c42\u200b\u7ed3\u6784\u200b\n\n    def forward(self, x):\n        # \u200b\u5b9a\u4e49\u200b\u524d\u5411\u200b\u4f20\u64ad\u200b\u6d41\u7a0b\u200b\n</code></pre>"},{"location":"CNN_project/#4","title":"4. \u200b\u8bad\u7ec3\u200b\u6d41\u7a0b","text":"<ul> <li>\u200b\u4f18\u5316\u200b\u5668\u200b\uff1aAdam (\u200b\u81ea\u200b\u9002\u5e94\u200b\u5b66\u4e60\u200b\u7387\u200b)</li> <li>\u200b\u635f\u5931\u200b\u51fd\u6570\u200b\uff1a\u200b\u4ea4\u53c9\u200b\u71b5\u200b\u635f\u5931\u200b (CrossEntropyLoss)</li> <li>\u200b\u8bc4\u4f30\u200b\u6307\u6807\u200b\uff1a\u200b\u6d4b\u8bd5\u200b\u96c6\u200b\u51c6\u786e\u7387\u200b</li> </ul>"},{"location":"CNN_project/#5","title":"5. \u200b\u8bc4\u4f30\u200b\u51fd\u6570","text":"<pre><code>def evaluate(cnn):\n    # \u200b\u5207\u6362\u200b\u8bc4\u4f30\u200b\u6a21\u5f0f\u200b\n    # \u200b\u5173\u95ed\u200b\u68af\u5ea6\u200b\u8ba1\u7b97\u200b\n    # \u200b\u8ba1\u7b97\u200b\u9884\u6d4b\u200b\u51c6\u786e\u7387\u200b\n</code></pre>"},{"location":"CNN_project/#_5","title":"\u8fd0\u884c\u200b\u7ed3\u679c","text":"<p>\u200b\u8bad\u7ec3\u200b3\u200b\u8f6e\u540e\u200b\u7684\u200b\u5178\u578b\u200b\u8f93\u51fa\u200b\uff1a</p> <pre><code>\u200b\u7b2c\u200b 1/3 \u200b\u8f6e\u200b\u8bad\u7ec3\u200b\u5f00\u59cb\u200b\n  Epoch 1 | Step   20 | Loss: 0.1234 | \u200b\u6d4b\u8bd5\u200b\u51c6\u786e\u7387\u200b: 0.9640 (96.40%)\n  Epoch 1 | Step   40 | Loss: 0.0456 | \u200b\u6d4b\u8bd5\u200b\u51c6\u786e\u7387\u200b: 0.9780 (97.80%)\n...\n\u200b\u8bad\u7ec3\u200b\u5b8c\u6210\u200b\uff01\n\u200b\u6700\u7ec8\u200b\u6d4b\u8bd5\u200b\u51c6\u786e\u7387\u200b\uff1a0.9850 (98.50%)\n</code></pre>"},{"location":"CNN_project/#_6","title":"\u6559\u5b66\u200b\u8981\u70b9","text":""},{"location":"CNN_project/#1_2","title":"1. \u200b\u6df1\u5ea6\u200b\u5b66\u4e60\u200b\u57fa\u7840\u200b\u6982\u5ff5","text":"<ul> <li>\u200b\u524d\u5411\u200b\u4f20\u64ad\u200b\uff1a\u200b\u6570\u636e\u200b\u4ece\u200b\u8f93\u5165\u200b\u5230\u200b\u8f93\u51fa\u200b\u7684\u200b\u8ba1\u7b97\u200b\u8fc7\u7a0b\u200b</li> <li>\u200b\u53cd\u5411\u200b\u4f20\u64ad\u200b\uff1a\u200b\u6839\u636e\u200b\u635f\u5931\u200b\u8c03\u6574\u200b\u7f51\u7edc\u200b\u53c2\u6570\u200b\u7684\u200b\u8fc7\u7a0b\u200b</li> <li>\u200b\u68af\u5ea6\u200b\u4e0b\u964d\u200b\uff1a\u200b\u4f18\u5316\u200b\u7b97\u6cd5\u200b\uff0c\u200b\u6700\u5c0f\u5316\u200b\u635f\u5931\u200b\u51fd\u6570\u200b</li> </ul>"},{"location":"CNN_project/#2-cnn","title":"2. CNN\u200b\u6838\u5fc3\u601d\u60f3","text":"<ul> <li>\u200b\u5c40\u90e8\u200b\u611f\u53d7\u200b\u91ce\u200b\uff1a\u200b\u5377\u79ef\u200b\u6838\u53ea\u200b\u5173\u6ce8\u200b\u5c40\u90e8\u200b\u533a\u57df\u200b</li> <li>\u200b\u6743\u503c\u200b\u5171\u4eab\u200b\uff1a\u200b\u540c\u4e00\u200b\u5377\u79ef\u200b\u6838\u5728\u200b\u6574\u4e2a\u200b\u56fe\u50cf\u200b\u4e0a\u200b\u6ed1\u52a8\u200b</li> <li>\u200b\u5e73\u79fb\u200b\u4e0d\u53d8\u6027\u200b\uff1a\u200b\u6c60\u5316\u200b\u64cd\u4f5c\u200b\u589e\u5f3a\u200b\u4f4d\u7f6e\u200b\u9c81\u68d2\u6027\u200b</li> </ul>"},{"location":"CNN_project/#3","title":"3. \u200b\u5b9e\u8df5\u200b\u6280\u5de7","text":"<ul> <li>\u200b\u6279\u200b\u5f52\u4e00\u5316\u200b\u7684\u200b\u4f5c\u7528\u200b\uff1a\u200b\u52a0\u901f\u200b\u6536\u655b\u200b\uff0c\u200b\u5141\u8bb8\u200b\u66f4\u5927\u200b\u5b66\u4e60\u200b\u7387\u200b</li> <li>Dropout\u200b\u9632\u6b62\u200b\u8fc7\u200b\u62df\u5408\u200b\uff1a\u200b\u8bad\u7ec3\u200b\u65f6\u200b\u968f\u673a\u200b\u5931\u6d3b\u200b\u795e\u7ecf\u5143\u200b</li> <li>\u200b\u5b66\u4e60\u200b\u7387\u200b\u8bbe\u7f6e\u200b\uff1a\u200b\u8fc7\u200b\u5927\u4f1a\u200b\u9707\u8361\u200b\uff0c\u200b\u8fc7\u200b\u5c0f\u200b\u6536\u655b\u200b\u6162\u200b</li> </ul>"},{"location":"CNN_project/#_7","title":"\u6269\u5c55\u200b\u4e0e\u200b\u4f18\u5316\u200b\u65b9\u5411","text":""},{"location":"CNN_project/#1_3","title":"1. \u200b\u7f51\u7edc\u7ed3\u6784\u200b\u6539\u8fdb","text":"<ul> <li>\u200b\u589e\u52a0\u200b\u5377\u79ef\u200b\u5c42\u200b\u6df1\u5ea6\u200b</li> <li>\u200b\u4f7f\u7528\u200b\u4e0d\u540c\u200b\u5927\u5c0f\u200b\u7684\u200b\u5377\u79ef\u200b\u6838\u200b</li> <li>\u200b\u6dfb\u52a0\u200b\u66f4\u591a\u5168\u200b\u8fde\u63a5\u200b\u5c42\u200b</li> </ul>"},{"location":"CNN_project/#2_2","title":"2. \u200b\u6b63\u5219\u200b\u5316\u200b\u6280\u672f","text":"<ul> <li>L2\u200b\u6b63\u5219\u200b\u5316\u200b</li> <li>\u200b\u6570\u636e\u200b\u589e\u5f3a\u200b\uff08\u200b\u65cb\u8f6c\u200b\u3001\u200b\u5e73\u79fb\u200b\u3001\u200b\u7f29\u653e\u200b\uff09</li> <li>\u200b\u65e9\u200b\u505c\u6cd5\u200b\uff08Early Stopping\uff09</li> </ul>"},{"location":"CNN_project/#3_1","title":"3. \u200b\u8d85\u200b\u53c2\u6570\u200b\u4f18\u5316","text":"<ul> <li>\u200b\u5b66\u4e60\u200b\u7387\u200b\u8c03\u5ea6\u200b\uff08\u200b\u5b66\u4e60\u200b\u7387\u200b\u8870\u51cf\u200b\uff09</li> <li>\u200b\u6279\u91cf\u200b\u5927\u5c0f\u200b\u8c03\u6574\u200b</li> <li>\u200b\u4e0d\u540c\u200b\u4f18\u5316\u200b\u5668\u200b\u6bd4\u8f83\u200b\uff08SGD\u3001RMSprop\u200b\u7b49\u200b\uff09</li> </ul>"},{"location":"CNN_project/#4_1","title":"4. \u200b\u53ef\u89c6\u5316\u200b\u5206\u6790","text":"<ul> <li>\u200b\u7279\u5f81\u200b\u56fe\u200b\u53ef\u89c6\u5316\u200b</li> <li>\u200b\u635f\u5931\u200b\u66f2\u7ebf\u200b\u7ed8\u5236\u200b</li> <li>\u200b\u6df7\u6dc6\u200b\u77e9\u9635\u200b\u5206\u6790\u200b</li> </ul>"},{"location":"CNN_project/#_8","title":"\u73af\u5883\u200b\u8981\u6c42","text":"<ul> <li>Python\uff1a3.6+</li> <li>PyTorch\uff1a1.8+</li> <li>torchvision\uff1a0.9+</li> <li>NumPy\uff1a1.19+</li> </ul>"},{"location":"CNN_project/#_9","title":"\u5feb\u901f\u200b\u5f00\u59cb","text":"<ol> <li>\u200b\u5b89\u88c5\u200b\u4f9d\u8d56\u200b\uff1a</li> </ol> <pre><code>pip install torch torchvision numpy\n</code></pre> <ol> <li>\u200b\u8fd0\u884c\u200b\u4ee3\u7801\u200b\uff1a</li> </ol> <pre><code>python src/chap05_CNN/CNN_pytorch.py\n</code></pre> <ol> <li>\u200b\u89c2\u5bdf\u200b\u8f93\u51fa\u200b\uff1a</li> <li>\u200b\u6a21\u578b\u200b\u7ed3\u6784\u200b\u6253\u5370\u200b</li> <li>\u200b\u8bad\u7ec3\u200b\u8fc7\u7a0b\u200b\u4e2d\u200b\u7684\u200b\u635f\u5931\u200b\u548c\u200b\u51c6\u786e\u7387\u200b</li> <li>\u200b\u6700\u7ec8\u200b\u6d4b\u8bd5\u200b\u51c6\u786e\u7387\u200b</li> </ol>"},{"location":"CNN_project/#_10","title":"\u603b\u7ed3","text":"<p>\u200b\u672c\u200b\u9879\u76ee\u200b\u63d0\u4f9b\u200b\u4e86\u200b\u4e00\u4e2a\u200b\u5b8c\u6574\u200b\u7684\u200bCNN\u200b\u5b9e\u73b0\u200b\u793a\u4f8b\u200b\uff0c\u200b\u5305\u542b\u200b\u4e86\u200b\u6df1\u5ea6\u200b\u5b66\u4e60\u200b\u9879\u76ee\u200b\u7684\u200b\u57fa\u672c\u8981\u7d20\u200b\uff1a - \u2705 \u200b\u6570\u636e\u5904\u7406\u200b\u548c\u200b\u52a0\u8f7d\u200b - \u2705 \u200b\u7f51\u7edc\u200b\u6a21\u578b\u200b\u5b9a\u4e49\u200b - \u2705 \u200b\u8bad\u7ec3\u200b\u6d41\u7a0b\u200b\u5b9e\u73b0\u200b - \u2705 \u200b\u6a21\u578b\u200b\u8bc4\u4f30\u200b\u529f\u80fd\u200b - \u2705 \u200b\u8be6\u7ec6\u200b\u7684\u200b\u4ee3\u7801\u200b\u6ce8\u91ca\u200b</p> <p>\u200b\u8fd9\u4e2a\u200b\u5b9e\u73b0\u200b\u65e2\u200b\u9002\u5408\u200b\u521d\u5b66\u8005\u200b\u7406\u89e3\u200bCNN\u200b\u7684\u200b\u57fa\u672c\u539f\u7406\u200b\uff0c\u200b\u4e5f\u200b\u4fbf\u4e8e\u200b\u8fdb\u4e00\u6b65\u200b\u6269\u5c55\u200b\u548c\u200b\u4f18\u5316\u200b\uff0c\u200b\u662f\u200b\u4e00\u4e2a\u200b\u4f18\u79c0\u200b\u7684\u200b\u6559\u5b66\u200b\u9879\u76ee\u200b\u793a\u4f8b\u200b\u3002</p>"}]}