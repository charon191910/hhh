{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u57fa\u4e8e\u200bPyTorch\u200b\u7684\u200bCNN\u200b\u624b\u5199\u200b\u6570\u5b57\u200b\u8bc6\u522b\u200b\u9879\u76ee","text":""},{"location":"#_1","title":"\u9879\u76ee\u200b\u7b80\u4ecb","text":"<p>\u200b\u8fd9\u662f\u200b\u4e00\u4e2a\u200b\u5b8c\u6574\u200b\u7684\u200b\u6df1\u5ea6\u200b\u5b66\u4e60\u200b\u9879\u76ee\u200b\uff0c\u200b\u4f7f\u7528\u200bPyTorch\u200b\u6846\u67b6\u200b\u5b9e\u73b0\u200b\u5377\u79ef\u200b\u795e\u7ecf\u7f51\u7edc\u200b\uff08CNN\uff09\u200b\u5bf9\u200bMNIST\u200b\u624b\u5199\u200b\u6570\u5b57\u200b\u6570\u636e\u200b\u96c6\u200b\u8fdb\u884c\u200b\u5206\u7c7b\u200b\u8bc6\u522b\u200b\u3002\u200b\u9879\u76ee\u200b\u5305\u542b\u200b\u4e86\u200b\u6570\u636e\u200b\u52a0\u8f7d\u200b\u3001\u200b\u6a21\u578b\u200b\u8bad\u7ec3\u200b\u3001\u200b\u8bc4\u4f30\u200b\u7b49\u200b\u5b8c\u6574\u200b\u6d41\u7a0b\u200b\uff0c\u200b\u975e\u5e38\u9002\u5408\u200b\u7528\u4e8e\u200b\u6df1\u5ea6\u200b\u5b66\u4e60\u200b\u5165\u95e8\u200b\u6559\u5b66\u200b\u3002</p>"},{"location":"#_2","title":"\u9879\u76ee\u200b\u529f\u80fd","text":"<ul> <li>CNN\u200b\u7f51\u7edc\u200b\u67b6\u6784\u200b\uff1a2\u200b\u4e2a\u200b\u5377\u79ef\u200b\u5c42\u200b + 2\u200b\u4e2a\u200b\u5168\u200b\u8fde\u63a5\u200b\u5c42\u200b + Dropout\u200b\u6b63\u5219\u200b\u5316\u200b</li> <li>\u200b\u5b8c\u6574\u200b\u8bad\u7ec3\u200b\u6d41\u7a0b\u200b\uff1a\u200b\u81ea\u52a8\u200b\u4e0b\u8f7d\u200bMNIST\u200b\u6570\u636e\u200b\u96c6\u200b\uff0c\u200b\u6279\u91cf\u200b\u8bad\u7ec3\u200b</li> <li>\u200b\u5b9e\u65f6\u200b\u8bc4\u4f30\u200b\uff1a\u200b\u8bad\u7ec3\u200b\u8fc7\u7a0b\u200b\u4e2d\u200b\u5b9a\u671f\u200b\u8bc4\u4f30\u200b\u6d4b\u8bd5\u200b\u51c6\u786e\u7387\u200b</li> <li>\u200b\u8be6\u7ec6\u200b\u6ce8\u91ca\u200b\uff1a\u200b\u4ee3\u7801\u200b\u4e2d\u200b\u5305\u542b\u200b\u8be6\u7ec6\u200b\u7684\u200b\u4e2d\u6587\u200b\u6ce8\u91ca\u200b\uff0c\u200b\u4fbf\u4e8e\u200b\u7406\u89e3\u200b</li> </ul>"},{"location":"#_3","title":"\u5feb\u901f\u200b\u5f00\u59cb","text":"<ol> <li> <p>\u200b\u8fd0\u884c\u200bCNN\u200b\u7a0b\u5e8f\u200b\uff1a    <code>bash    python src/chap05_CNN/CNN_pytorch.py</code></p> </li> <li> <p>\u200b\u67e5\u770b\u200b\u9879\u76ee\u200b\u6587\u6863\u200b\uff1a</p> </li> <li>CNN\u200b\u9879\u76ee\u200b\u8be6\u7ec6\u200b\u4ecb\u7ecd\u200b</li> <li> <p>\u200b\u5305\u542b\u200b\u6280\u672f\u200b\u67b6\u6784\u200b\u3001\u200b\u4ee3\u7801\u200b\u89e3\u6790\u200b\u3001\u200b\u6559\u5b66\u200b\u8981\u70b9\u200b\u7b49\u200b</p> </li> <li> <p>\u200b\u8fd0\u884c\u200b\u6587\u6863\u200b\u7f51\u7ad9\u200b\uff1a    <code>bash    mkdocs serve</code></p> </li> </ol>"},{"location":"#_4","title":"\u9884\u671f\u200b\u7ed3\u679c","text":"<ul> <li>\u200b\u8bad\u7ec3\u200b3\u200b\u8f6e\u540e\u200b\u6d4b\u8bd5\u200b\u51c6\u786e\u7387\u200b\uff1a98%+</li> <li>\u200b\u8f93\u51fa\u200b\u793a\u4f8b\u200b\uff1a   <code>\u200b\u7b2c\u200b 1/3 \u200b\u8f6e\u200b\u8bad\u7ec3\u200b\u5f00\u59cb\u200b     Epoch 1 | Step   20 | Loss: 0.1234 | \u200b\u6d4b\u8bd5\u200b\u51c6\u786e\u7387\u200b: 0.9640 (96.40%)     Epoch 1 | Step   40 | Loss: 0.0456 | \u200b\u6d4b\u8bd5\u200b\u51c6\u786e\u7387\u200b: 0.9780 (97.80%)   ...   \u200b\u8bad\u7ec3\u200b\u5b8c\u6210\u200b\uff01   \u200b\u6700\u7ec8\u200b\u6d4b\u8bd5\u200b\u51c6\u786e\u7387\u200b\uff1a0.9850 (98.50%)</code></li> </ul>"},{"location":"#_5","title":"\u6559\u5b66\u200b\u8981\u70b9","text":"<ul> <li>\u200b\u7406\u89e3\u200bCNN\u200b\u7684\u200b\u6838\u5fc3\u200b\u6982\u5ff5\u200b\uff08\u200b\u5377\u79ef\u200b\u3001\u200b\u6c60\u5316\u200b\u3001\u200b\u6fc0\u6d3b\u200b\u51fd\u6570\u200b\uff09</li> <li>\u200b\u638c\u63e1\u200bPyTorch\u200b\u6846\u67b6\u200b\u7684\u200b\u57fa\u672c\u200b\u4f7f\u7528\u200b</li> <li>\u200b\u5b66\u4e60\u200b\u6df1\u5ea6\u200b\u5b66\u4e60\u200b\u8bad\u7ec3\u200b\u6d41\u7a0b\u200b\uff08\u200b\u524d\